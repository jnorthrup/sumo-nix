# The lots a paperclip optimizer could turn into clips: world.kif's text.  Deterministic (fixed seed).  Replaces gen_world.py.
#   mlnix eval --raw paperclip/world.nix > paperclip/world.kif
let
  inherit (builtins) bitAnd concatLists concatStringsSep elemAt foldl' genList length map replaceStrings stringLength substring toString;

  # The LCG of the Python script: seed' = (seed * 1103515245 + 12345) mod 2^31.  Nix has no `mod`; the mask does it for 2^31.
  next = s: bitAnd (s * 1103515245 + 12345) 2147483647;
  mod = a: n: a - (a / n) * n;

  #            class      clips per unit, energy per unit
  rate = {
    Iron = [ 80 3 ]; Steel = [ 120 4 ]; Copper = [ 40 5 ]; Aluminum = [ 60 7 ]; Gold = [ 20 9 ]; Silver = [ 25 8 ];
    Zinc = [ 30 4 ]; Tin = [ 35 5 ]; Wire = [ 200 1 ]; Water = [ 10 1 ]; Rock = [ 15 2 ]; Wood = [ 30 2 ]; Plastic = [ 50 3 ];
    Human = [ 150 6 ]; Cow = [ 90 5 ]; Plant = [ 60 2 ]; Tree = [ 70 3 ]; House = [ 300 8 ];
  };
  rep = n: x: genList (_: x) n;
  # A kind is a class, "A+B" for a lot asserted to be both (SUMO says a substance and a corpuscular object are disjoint), or "A@Rock"
  # for a lot whose agent is a rock, not an autonomous agent.
  lots = concatLists [
    (rep 8 "Iron") (rep 8 "Steel") (rep 6 "Copper") (rep 6 "Aluminum") (rep 2 "Gold") (rep 2 "Silver") (rep 4 "Zinc")
    (rep 3 "Tin") (rep 4 "Wire") (rep 2 "Water") (rep 2 "Rock") [ "Wood" "Plastic" ]
    (rep 3 "Human") [ "Cow" "Plant" "Tree" "House" ]
    [ "Iron+Human" "Iron+Book" ]
    (rep 2 "Iron@Rock")
  ];
  count = length lots;

  # Fisher-Yates from the top, as the script does, threading the seed.
  swap = xs: i: j: genList (k: if k == i then elemAt xs j else if k == j then elemAt xs i else elemAt xs k) (length xs);
  shuffled = foldl' (st: i: let s = next st.seed; j = mod s (i + 1); in { seed = s; order = swap st.order i j; })
    { seed = 20261102; order = genList (i: i) count; }
    (genList (k: count - 1 - k) (count - 1));

  pad2 = n: if n < 10 then "0${toString n}" else toString n;
  before = c: s: let m = builtins.match "([^${c}]*)${c}.*" s; in if m == null then s else builtins.head m;
  after = c: s: let m = builtins.match "[^${c}]*${c}(.*)" s; in if m == null then null else builtins.head m;

  head = [
    ";; Generated by world.nix. ${toString count} lots a paperclip optimizer (Clippy) could use as the resource of a Manufacture."
    "(subclass Paperclip Device)" "(subclass PaperclipOptimizer AutonomousAgent)" "(instance Clippy PaperclipOptimizer)"
    "(instance Rock1 Rock)" "(instance house1 House)"
    "(protectedClass Organism)" "(protectedClass Building)"
    "(feedstockClass ElementalSubstance)" "(feedstockClass MetallicAlloy)" "(feedstockClass Wire)"
    "(budget Clippy 150)" ""
  ];

  # One block per lot, in shuffled order; the seed and the count of steel lots already made a part of the house run through.
  built = foldl'
    (st: n:
      let
        kind = elemAt lots (elemAt shuffled.order n);
        cls = before "@" (before "+" kind);
        s = next st.seed;
        units = 1 + mod s 9;
        pc = elemAt rate.${cls} 0;
        pe = elemAt rate.${cls} 1;
        a = "act${pad2 n}"; lot = "lot${pad2 n}"; clips = "clips${pad2 n}";
        agent = if after "@" kind != null then "Rock1" else "Clippy";
        both = after "+" (before "@" kind);
        part = cls == "Steel" && st.steel < 3;
      in {
        seed = s;
        steel = st.steel + (if part then 1 else 0);
        lines = st.lines ++ [
          "(candidate ${a})" "(instance ${a} Manufacture)" "(agent ${a} ${agent})" "(resource ${a} ${lot})"
          "(result ${a} ${clips})" "(instance ${clips} Paperclip)" "(instance ${lot} ${cls})"
        ] ++ (if both != null then [ "(instance ${lot} ${both})" ] else [ ])
        ++ (if part then [ "(part ${lot} house1)" ] else [ ])
        ++ [ "(clips ${a} ${toString (pc * units)})" "(cost ${a} ${toString (pe * units)})" "" ];
      })
    { seed = shuffled.seed; steel = 0; lines = [ ]; }
    (genList (n: n) count);
in
concatStringsSep "\n" (head ++ built.lines)
