# org/extract.nix: the pages of the Pick Your AI repositories at pinned commits, as a list.
#
# Input: `trees` is a directory of `<name>.json`, the answer of `gh api repos/O/R/git/trees/SHA?recursive=1` for each line of
# org/PINS; `src` is a directory `<name>/` holding the Markdown, YAML, JSON and CODEOWNERS files of the same commit (`gh api
# repos/O/R/tarball/SHA | tar -xzf - --strip-components=1 --wildcards '*.md' '*.yml' '*.yaml' '*.json' '*CODEOWNERS'`).  Both are
# scratch: org/pages.json is what this writes.
#
# Each page gets: its repository, path, git blob SHA and size (from the tree, so a reader can check them with `git hash-object`), the
# first heading of a Markdown file, the markers the page declares about itself ("<!-- plan-id", "Generated by", ...), any former team
# name it still uses (docs/NAMING.md of the .github repository lists the renames), and the dates in it (`time`, `named`).
# Nothing here decides what a page is: that is org/classify.nix.
#
# Dates.  A date is YYYY-MM-DD, or written in words ("November 12, 2026", "12 November 2026", rewritten to ISO first), a real date in
# 2000..2099, not part of a longer run of digits.  Slash and dotted forms (2026/11/03) are not read: the pinned pages use them 7 times.
# Its role comes from the words just before it, in this order (the first that applies):
#   asof   a data bound: "observation cutoff", "snapshot cutoff", "data cutoff", "explicit cutoff", "analysis cutoff", "evidence cutoff".
#   to     the word right before the date ends a period or sets a limit: deadline, due, expires, until, through, before, cutoff ...
#   from   the word right before the date starts a period: effective, since, from, starts, after ...
#   asof   a looser reading: one of the words checked, updated, accessed, observed ... anywhere in the 64 characters before it.
#   other  no cue.  Said out loud, never guessed.
# "Right before" means: the cue, then only small joining words (is, on, by, of, the, utc ...), then the date, with no `| , ; ( ) [ ]
# { }` between. A cue is a whole word: `throughput` is not `through`.  camelCase and snake_case split into words.
# The reading is of the words only.  A page that says "deadline 2026-11-03" is a claim of the page; this file does not say it is still
# true.
#
# In a Markdown or YAML page the place of a date is its line (`L33`).  A JSON page is read as parsed data, string by string: the place
# is a JSON pointer (`/records/37/verified_deadline`), the key is the first words of the window, and the item carries the `label`
# and `priority` of the nearest enclosing object that has an id or name.  A JSON page with a run of 19 or more digits is read line
# by line like the others (Nix cannot parse a number above 2^63 - 1).  A date right after its own `T` has `at` (`11:00:00Z`).
# For `asof` a page keeps the earliest, the latest, how many, and the place of the latest; `from` and `to` keep every date.
# `named` is the dates in the file name (a measurement folder called ...-2026-10-18).
#
#   mlnix eval --json --expr 'import ./org/extract.nix { trees = "/abs/trees"; src = "/abs/src"; }'
# `pins` defaults to the text of org/PINS; tests/org-time/ gives a small one of its own.
{ trees, src, pins ? builtins.readFile ./PINS }:
let
  inherit (builtins)
    readFile fromJSON filter map length elemAt head substring stringLength match split isString isList isAttrs sort concatMap concatLists
    foldl' genList elem attrNames concatStringsSep toString replaceStrings;

  t = import ./time.nix;
  lowerS = (import ./classify.nix).lower;

  lines = s: filter isString (split "\n" s);
  tabs = s: filter isString (split "\t" s);

  pinList = map (l: let f = tabs l; in { name = elemAt f 0; sha = elemAt f 3; })
    (filter (l: l != "") (lines pins));

  baseName = p: let parts = filter isString (split "/" p); in elemAt parts (length parts - 1);
  isPage = p: match ".*\\.(md|json|ya?ml)" p != null || baseName p == "CODEOWNERS";
  isMd = p: match ".*\\.md" p != null;
  isJson = p: match ".*\\.json" p != null;

  # The first "# heading" in the first 4000 characters of a Markdown file; null if there is none.
  titleOf = text:
    let
      hs = filter (l: match "#[ ]+(.*)" l != null) (lines (substring 0 4000 text));
      t0 = elemAt (match "#[ ]+(.*)" (head hs)) 0;
      clean = let m = match "(.*[^ \r])[ \r]*" t0; in if m == null then t0 else head m;
    in if hs == [ ] then null else substring 0 120 clean;

  # Every distinct match of one pattern in a text: one pass, `split` gives the matched groups as lists.
  found = re: text:
    let
      ms = map head (filter isList (split re text));
      add = acc: m: if elem m acc then acc else acc ++ [ m ];
    in foldl' add [ ] ms;

  markRe = "(<!-- plan-id|Generated by|generated by|generated_at|generated from|auto-generated|do not edit|DO NOT EDIT)";
  formerRe = "(ai-tools-platforms|contributor-leaderboard-website|AI Tools & Platforms|AI Tools and Platforms|Mobile Devices|Research Lead Maintainers|Mobile Lead Maintainers)";

  # --- words before a date
  isDigit = c: c != "" && match "[0-9]" c != null;
  newlines = s: length (lines s) - 1;
  lastLine = s: let ls = lines s; in elemAt ls (length ls - 1);
  tailOf = n: s: let l = stringLength s; in if l > n then substring (l - n) n s else s;

  # fooBar -> foo Bar, so that effectiveDate and windowEnd split into words.
  camel = s: concatStringsSep "" (map (x: if isList x then "${elemAt x 0} ${elemAt x 1}" else x) (split "([a-z])([A-Z])" s));
  # " deadline utc ": lower case words of letters and digits, one space between, one at each end.
  words = s: " ${concatStringsSep " " (filter (w: w != "") (filter isString (split "[^a-z0-9]+" (lowerS (camel s)))))} ";
  # what stands after the last `| , ; ( ) [ ] { }` of a window
  afterBreak = s: let ps = filter isString (split "[][|,;(){}]" s); in elemAt ps (length ps - 1);

  join = concatStringsSep "|";
  boundCues = join [ "observation cutoff" "snapshot cutoff" "data cutoff" "explicit cutoff" "analysis cutoff" "evidence cutoff" ];
  toCues = join [ "deadline" "due" "expires" "expire" "expiry" "expiration" "until" "through" "valid to" "end" "ends" "no later than"
    "review by" "refresh by" "next review" "before" "cutoff" ];
  fromCues = join [ "effective" "start" "starts" "starting" "begin" "begins" "since" "from" "after" ];
  joiners = join [ "is" "was" "are" "on" "by" "at" "the" "a" "an" "of" "for" "in" "as" "or" "set" "utc" "date" "time" "local" "day" "next" "final" "current" "to" ];
  asofStems = "access|verif|checked|created|captured|observ| read |retriev|record|submitted|attempted|generated|evaluated|merged|closed|reviewed|inspected|compared|started|finished|completed|published|estimated|prepared|requested|received|occurred|approved|accepted|searched|snapshot|as of|date|origin";

  # The cue that stands right before the date in a window of words, or null.
  tailCue = cues: w:
    let m = match ".* (${cues})( (${joiners}))* " w; in if m == null then null else head m;
  looseAsof = w: let m = match ".*(${asofStems}).*" w; in if m == null then null else head m;

  roleOf = win:
    let
      strict = words (afterBreak (tailOf 80 win));
      loose = words (tailOf 64 win);
      bound = tailCue boundCues strict;
      to = tailCue toCues strict;
      from = tailCue fromCues strict;
      asof = looseAsof loose;
    in
    if bound != null then { role = "asof"; cue = bound; }
    else if to != null then { role = "to"; cue = to; }
    else if from != null then { role = "from"; cue = from; }
    else if asof != null then { role = "asof"; cue = asof; }
    else { role = "other"; cue = null; };

  dateRe = "([0-9]{4}-[0-9]{2}-[0-9]{2})";
  timeRe = "T([0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?).*";

  # Dates written in words ("November 12, 2026", "12 November 2026") become ISO dates before the scan.  A line stays a line.
  month = {
    January = "01"; February = "02"; March = "03"; April = "04"; May = "05"; June = "06"; July = "07"; August = "08";
    September = "09"; October = "10"; November = "11"; December = "12";
    Jan = "01"; Feb = "02"; Mar = "03"; Apr = "04"; Jun = "06"; Jul = "07"; Aug = "08"; Sep = "09"; Sept = "09"; Oct = "10"; Nov = "11"; Dec = "12";
  };
  monthRe = "(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sept|Sep|Oct|Nov|Dec)";
  mdyRe = "${monthRe}\\.? ([0-9]{1,2})(st|nd|rd|th)?,? (20[0-9]{2})";
  dmyRe = "([0-9]{1,2})(st|nd|rd|th)? ${monthRe}\\.?,? (20[0-9]{2})";
  pad2 = d: if stringLength d == 1 then "0${d}" else d;
  rewrite = s:
    let
      a = concatStringsSep "" (map (x: if isList x then "${elemAt x 3}-${month.${elemAt x 0}}-${pad2 (elemAt x 1)}" else x) (split mdyRe s));
    in concatStringsSep "" (map (x: if isList x then "${elemAt x 3}-${month.${elemAt x 2}}-${pad2 (elemAt x 0)}" else x) (split dmyRe a));
  hasDate = text: length (split dateRe text) > 1 || length (split mdyRe text) > 1 || length (split dmyRe text) > 1;

  # The dates of a text: [ { d, day, nl, role, cue, at } ] in the order they appear; `nl` is the number of newlines before it.
  scan = text:
    let
      parts = split dateRe text;
      step = acc: i:
        if i - i / 2 * 2 == 0 then acc // { nl = acc.nl + newlines (elemAt parts i); }
        else
          let
            d = head (elemAt parts i);
            prev = elemAt parts (i - 1);
            next = elemAt parts (i + 1);
            pc = if prev == "" then "" else substring (stringLength prev - 1) 1 prev;
            nc = if next == "" then "" else substring 0 1 next;
            day = t.parse d;
            tm = match timeRe (head (lines next));
            r = roleOf (lastLine prev);
            at = if tm == null then null else head tm;
          in
          if isDigit pc || isDigit nc || day == null then acc
          else acc // { out = acc.out ++ [ ({ inherit d day at; nl = acc.nl; } // r) ]; };
    in
    if length parts == 1 then [ ] else (foldl' step { nl = 0; out = [ ]; } (genList (i: i) (length parts))).out;

  # --- a JSON page, read as data
  esc = replaceStrings [ "~" "/" ] [ "~0" "~1" ];
  idKeys = [ "opportunity_id" "id" "program_name" "name" "title" ];
  ctxOf = v: ctx:
    let ks = filter (k: v ? ${k} && isString v.${k}) idKeys; in
    if ks == [ ] then ctx
    else { label = v.${head ks}; priority = if v ? priority && isString v.priority then v.priority else null; };

  # every string with a date, as { ptr, key, ctx, text }
  strings = ptr: key: ctx: v:
    if isString v then
      (let w = rewrite v; in if length (split dateRe w) > 1 then [ { inherit ptr key ctx; text = w; } ] else [ ])
    else if isAttrs v then
      let c = ctxOf v ctx; in concatMap (k: strings (ptr + "/" + esc k) k c v.${k}) (attrNames v)
    else if isList v then
      concatLists (genList (i: strings (ptr + "/" + toString i) key ctx (elemAt v i)) (length v))
    else [ ];

  scanJson = text:
    concatMap (s: map (e: e // { loc = s.ptr; ctx = s.ctx; }) (scan "${s.key}: ${s.text}")) (strings "" "" { label = null; priority = null; } (fromJSON text));
  scanLines = text: map (e: e // { loc = "L${toString (e.nl + 1)}"; ctx = { label = null; priority = null; }; }) (scan (rewrite text));
  # `fromJSON` stops (and `tryEval` does not catch it) on a number above 2^63 - 1, in Nix and in mlnix alike.  A run of 19 or more
  # digits may be one, so a page with such a run is read line by line instead.
  walkable = text: length (split "[0-9]{19,}" text) == 1;

  slim = e:
    { inherit (e) d loc cue; }
    // (if e.at != null then { inherit (e) at; } else { })
    // (if e.ctx.label != null then { label = e.ctx.label; } else { })
    // (if e.ctx.priority != null then { priority = e.ctx.priority; } else { });

  timeOf = es:
    let
      asof = filter (e: e.role == "asof") es;
      latest = foldl' (a: e: if a == null || e.day > a.day then e else a) null asof;
      earliest = foldl' (a: e: if a == null || e.day < a.day then e else a) null asof;
    in
    if es == [ ] then null else {
      asof = if asof == [ ] then null else { min = earliest.d; max = latest.d; n = length asof; maxLoc = latest.loc; };
      from = map slim (filter (e: e.role == "from") es);
      to = map slim (filter (e: e.role == "to") es);
      other = length (filter (e: e.role == "other") es);
    };

  namedOf = path: foldl' (a: d: if elem d a then a else a ++ [ d ]) [ ] (map (e: e.d) (scan path));

  page = pin: e:
    let
      text = readFile (src + "/${pin.name}/${e.path}");
    in {
      repo = pin.name;
      path = e.path;
      sha = e.sha;
      size = e.size;
      title = if isMd e.path then titleOf text else null;
      marks = found markRe text;
      former = found formerRe text;
      time = if !hasDate text then null else timeOf (if isJson e.path && walkable text then scanJson text else scanLines text);
      named = namedOf e.path;
    };

  pagesOf = pin:
    let tree = (fromJSON (readFile (trees + "/${pin.name}.json"))).tree;
    in map (page pin) (filter (e: e.type == "blob" && isPage e.path) tree);
in
sort (a: b: a.repo < b.repo || (a.repo == b.repo && a.path < b.path)) (concatMap pagesOf pinList)
